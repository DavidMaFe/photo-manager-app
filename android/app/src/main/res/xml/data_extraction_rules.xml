<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app goes to the Google backup nor to a new phone (docs/security-audit-2026-10.md, A4): the secrets
     are in the Keystore, which is never copied, and without them the rest is useless or personal data (the cached user,
     the file mapping). On a new phone the user logs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
